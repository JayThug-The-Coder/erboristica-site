  RewriteRule "^product/purysens\-maschera\-viso/?$" "/prodotto.html?id=purysens-maschera-viso-allargilla-rosa-purysens" [R=301,L]
  RewriteRule "^product/siero\-corpo\-elasticizzante/?$" "/prodotto.html?id=inn-min-1" [R=301,L]
  RewriteRule "^product/siero\-corpo\-rigenerante/?$" "/prodotto.html?id=inn-min-2" [R=301,L]

  # --- Prodotti Uomo ---
  RewriteRule "^product/balsamo\-dopobarba\-active/?$" "/prodotto.html?id=uomo-balsamo-dopobarba-uomo-active" [R=301,L]
  RewriteRule "^product/shampoo\-doccia\-active/?$" "/prodotto.html?id=uomo-shampoo-doccia-uomo-active" [R=301,L]
  RewriteRule "^product/uomo\-balsamo\-dopobarba/?$" "/prodotto.html?id=uomo-balsamo-dopobarba-uomo" [R=301,L]
