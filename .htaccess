  RewriteRule "^product/argan\-latte\-detergente\-viso/?$" "/linee/linea.html?id=argan" [R=301,L]
  RewriteRule "^product/argan\-lozione\-tonica\-viso/?$" "/linee/linea.html?id=argan" [R=301,L]
  RewriteRule "^product/detergente\-intimo\-calendula/?$" "/linee/linea.html?id=estratti" [R=301,L]
  RewriteRule "^product/sapone\-vegetale\-alle\-proteine\-del\-latte/?$" "/linee/linea.html?id=estratti" [R=301,L]
  RewriteRule "^product/maschera\-capelli\-istantanea\-miele\-e\-camomilla/?$" "/linee/linea.html?id=estratti" [R=301,L]
  RewriteRule "^product/shampoo\-delicato\-miele\-e\-camomilla/?$" "/linee/linea.html?id=estratti" [R=301,L]
  RewriteRule "^product/illumia\-siero\-viso\-antimacchie/?$" "/linee/linea.html?id=illumia" [R=301,L]
  RewriteRule "^product/siero\-viso\-illuminante/?$" "/prodotto.html?id=inn-pearls-c" [R=301,L]
  RewriteRule "^product/stop\-imperfection\-siero\-viso/?$" "/linee/linea.html?id=illumia" [R=301,L]
  RewriteRule "^product/power\-c\-siero\-viso/?$" "/linee/linea.html?id=illumia" [R=301,L]
  RewriteRule "^product/double\-express\-2\-in\-1\-maschera\-e\-scrub/?$" "/linee/linea.html?id=innovation" [R=301,L]
  RewriteRule "^product/magic\-powder\-polvere\-detergente/?$" "/linee/linea.html?id=innovation" [R=301,L]
  RewriteRule "^product/hydra\-5\-siero\-viso/?$" "/linee/linea.html?id=innovation" [R=301,L]
  RewriteRule "^product/pore\-fection\-trattamento\-pori\-dilatati/?$" "/linee/linea.html?id=innovation" [R=301,L]
  RewriteRule "^product/olio\-puro\-viso\-e\-decollete/?$" "/linee/linea.html?id=nutra" [R=301,L]
  RewriteRule "^product/purysens\-tonico\-viso/?$" "/linee/linea.html?id=purysens" [R=301,L]
  RewriteRule "^product/doccia\-schiuma\-energy/?$" "/linee/linea.html?id=uomo" [R=301,L]
  RewriteRule "^product/scrub\-corpo\-vellutante/?$" "/prodotto.html?id=cocco-scrub-corpo-cocco-e-monoi" [R=301,L]
  RewriteRule "^product/crema\-viso\-copia/?$" "/prodotto.html?id=uomo-crema-viso-uomo-active" [R=301,L]
  RewriteRule "^product/olio\-corpo/?$" "/prodotto.html?id=argan-olio-corpo-argan" [R=301,L]
  RewriteRule "^product/fast\-remover\-struccante\-occhi/?$" "/linee/erboristica.html" [R=301,L]
  RewriteRule "^product/perfect\-glow\-crema\-viso/?$" "/linee/erboristica.html" [R=301,L]
  RewriteRule "^product/pure\-skin\-tonico\-viso/?$" "/linee/erboristica.html" [R=301,L]
  RewriteRule "^product/sapone\-fluido\-elimina\-odori\-deodorina/?$" "/linee/erboristica.html" [R=301,L]
  RewriteRule "^product/tropical\-cleanser\-detergente\-struccante/?$" "/linee/erboristica.html" [R=301,L]

  # --- Catch-all di sicurezza (qualsiasi vecchio URL non mappato sopra) ---
  RewriteRule "^product/.*$" "/linee.html" [R=301,L]
  RewriteRule "^brands/.*$" "/linee.html" [R=301,L]
</IfModule>

# ────────────────────────────────────────────────────────────────
# Security headers
# ────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Force HTTPS for 1 year + subdomains
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # MIME-type sniffing protection
  Header always set X-Content-Type-Options "nosniff"

  # Referrer policy: send only origin to cross-origin
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Limit browser features (no camera, mic, geo by default)
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # CSP — start permissive, tighten later. Allow Google Fonts + inline styles.
  # NOTE: once GA / banner / Brevo aggiunti, va riconfigurato
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net; connect-src 'self' https://api.brevo.com https://www.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.facebook.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ────────────────────────────────────────────────────────────────
# Gzip compression
# ────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml font/woff font/woff2
</IfModule>

# ────────────────────────────────────────────────────────────────
# Cache headers
# ────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — short cache (so updates land fast)
  ExpiresByType text/html "access plus 1 hour"

  # CSS / JS — 1 month (versioned via filename if possible)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # Images / Fonts — 1 year
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # JSON / XML — short
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# ────────────────────────────────────────────────────────────────
# Disable directory listing
# ────────────────────────────────────────────────────────────────
Options -Indexes

# ────────────────────────────────────────────────────────────────
# Block sensitive files
# ────────────────────────────────────────────────────────────────
<FilesMatch "^(\.htaccess|\.git|\.env|\.DS_Store|CLAUDE\.md|PROGRESS\.md|HANDOFF\.md|KNOWLEDGE\.md|CONSEGNA-TECNICO\.md|AUDIT-.*\.md|README\.md|.*\.docx|.*\.zip)$">
  Require all denied
</FilesMatch>
