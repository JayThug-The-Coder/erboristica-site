  RewriteRule "^product/cocco\-maschera\-capelli\-istantanea/?$" "/prodotto.html?id=cocco-maschera-capelli-olio-di-cocco-e-monoi" [R=301,L]
  RewriteRule "^product/cocco\-mousse\-doccia/?$" "/prodotto.html?id=cocco-mousse-doccia-cocco" [R=301,L]
