  RewriteRule "^product/crema\-fluida\-corpo/?$" "/prodotto.html?id=mandorle-crema-fluida-corpo-mandorle-dolci" [R=301,L]
  RewriteRule "^product/crema\-mani\-e\-unghie/?$" "/prodotto.html?id=mandorle-crema-mani-e-unghie-mandorle-dolci" [R=301,L]
  RewriteRule "^product/crema\-viso\-prime\-rughe/?$" "/prodotto.html?id=mandorle-crema-viso-prime-rughe" [R=301,L]
  RewriteRule "^product/olio\-di\-mandorle\-dolci/?$" "/prodotto.html?id=mandorle-olio-mandorle-dolci-100-naturale" [R=301,L]
