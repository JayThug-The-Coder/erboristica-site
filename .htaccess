  RewriteRule "^product/bagno\-doccia\-camelia\-japonica/?$" "/prodotto.html?id=estratti-doccia-schiuma-camelia-japonica" [R=301,L]
  RewriteRule "^product/bagno\-doccia\-patchouli\-e\-neroli/?$" "/prodotto.html?id=estratti-doccia-schiuma-patchouli-e-neroli" [R=301,L]
  RewriteRule "^product/bagno\-doccia\-te\-verde/?$" "/prodotto.html?id=estratti-bagno-doccia-t%C3%A8-verde" [R=301,L,NE]
  RewriteRule "^product/burro\-di\-karite\-vitamina\-e/?$" "/prodotto.html?id=estratti-burro-di-karit%C3%A9-vitamina-e" [R=301,L,NE]
  RewriteRule "^product/crema\-corpo\-rosa\-essenziale/?$" "/prodotto.html?id=estratti-crema-corpo-rosa-essenziale" [R=301,L]
  RewriteRule "^product/olio\-corpo\-rosa\-essenziale/?$" "/prodotto.html?id=estratti-olio-corpo-rosa-essenziale" [R=301,L]
  RewriteRule "^product/crema\-mani\-unghie\-allolio\-di\-cotone/?$" "/prodotto.html?id=estratti-crema-mani-e-unghie-allolio-di-cotone" [R=301,L]
  RewriteRule "^product/maschera\-capelli\-semi\-di\-lino\-e\-burro\-di\-karite/?$" "/prodotto.html?id=estratti-maschera-per-capelli-semi-di-lino-e-karit%C3%A9" [R=301,L,NE]
  RewriteRule "^product/sapone\-vegetale\-al\-burro\-di\-karite/?$" "/prodotto.html?id=estratti-sapone-vegetale-al-burro-di-karit%C3%A9" [R=301,L,NE]
  RewriteRule "^product/sapone\-vegetale\-allamido\-di\-riso/?$" "/prodotto.html?id=estratti-sapone-vegetale-allamido-di-riso" [R=301,L]
  RewriteRule "^product/sapone\-vegetale\-allolio\-di\-oliva/?$" "/prodotto.html?id=estratti-sapone-vegetale-allolio-di-oliva" [R=301,L]
  RewriteRule "^product/sapone\-vegetale\-di\-marsiglia/?$" "/prodotto.html?id=estratti-sapone-vegetale-di-marsiglia" [R=301,L]
  RewriteRule "^product/sapone\-vegetale\-monoi\-di\-tahiti/?$" "/prodotto.html?id=estratti-sapone-vegetale-monoi-di-tahiti" [R=301,L]
  RewriteRule "^product/shampoo\-purificante\-betulla\-e\-menta\-piperita/?$" "/prodotto.html?id=estratti-shampoo-purificante-betulla-e-menta-piperita" [R=301,L]
  RewriteRule "^product/shampoo\-riparatore\-semi\-di\-lino\-e\-burro\-di\-karite/?$" "/prodotto.html?id=estratti-shampoo-riparatore-semi-di-lino-e-karit%C3%A9" [R=301,L,NE]

  # --- Prodotti Illumia / Mandorle / Nutra / Purysens / Mineral ---
