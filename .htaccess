# ═══════════════════════════════════════════════════════════════
# Athena's — Apache config (Siteground compatible)
# ═══════════════════════════════════════════════════════════════

# Default home: index.html
DirectoryIndex index.html

# Custom 404 page
ErrorDocument 404 /404.html

# ────────────────────────────────────────────────────────────────
# Force HTTPS (only if SSL is enabled)
# ────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ────────────────────────────────────────────────────────────────
# Redirect 301 dal vecchio sito WordPress (athenas.it) al sito nuovo.
# Target con estensione .html (su Apache gli URL puliti non esistono).
# Le righe "DA RIVEDERE" mandano prodotti dismessi/ambigui alla pagina linea.
# ════════════════════ NB: questo blocco e _redirects (Netlify) sono
# equivalenti; su Siteground (Apache) vale SOLO questo .htaccess. ═══════
# ────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Pagine ---
  RewriteRule "^about\-us\-athenas/?$" "/" [R=301,L]
  RewriteRule "^contatta\-athenas/?$" "/contatti.html" [R=301,L]
  RewriteRule "^ecosostenibilita\-2/?$" "/sostenibilita.html" [R=301,L]
  RewriteRule "^laboratorio\-2/?$" "/laboratorio.html" [R=301,L]
  RewriteRule "^privacy\-policy/?$" "/privacy.html" [R=301,L]

  # --- Hub brand ---
  RewriteRule "^brands/erboristica/?$" "/linee/erboristica.html" [R=301,L]
  RewriteRule "^brands/everby/?$" "/linee/everby.html" [R=301,L]
  RewriteRule "^brands/kaley/?$" "/linee/kaley.html" [R=301,L]
  RewriteRule "^brands/sphea/?$" "/linee/sphea.html" [R=301,L]
  RewriteRule "^brands/vintage/?$" "/linee.html" [R=301,L]

  # --- Linee L'Erboristica ---
  RewriteRule "^brands/erboristica/antieta\-globale/?$" "/linee/linea.html?id=antieta" [R=301,L]
  RewriteRule "^brands/erboristica/estratti\-botanici/?$" "/linee/linea.html?id=estratti" [R=301,L]
  RewriteRule "^brands/erboristica/illumia/?$" "/linee/linea.html?id=illumia" [R=301,L]
  RewriteRule "^brands/erboristica/nutra\-repair/?$" "/linee/linea.html?id=nutra" [R=301,L]
  RewriteRule "^brands/erboristica/olio\-di\-argan\-biologico/?$" "/linee/linea.html?id=argan" [R=301,L]
  RewriteRule "^brands/erboristica/olio\-di\-cocco/?$" "/linee/linea.html?id=cocco" [R=301,L]
  RewriteRule "^brands/erboristica/olio\-di\-mandorle\-dolci/?$" "/linee/linea.html?id=mandorle" [R=301,L]
  RewriteRule "^brands/erboristica/purysens/?$" "/linee/linea.html?id=purysens" [R=301,L]
  RewriteRule "^brands/erboristica/skincare\-innovation/?$" "/linee/linea.html?id=innovation" [R=301,L]
  RewriteRule "^brands/erboristica/skincare\-innovation/kit\-doppia\-detersione/?$" "/linee/linea.html?id=innovation" [R=301,L]
  RewriteRule "^brands/erboristica/skincare\-innovation/mineral\-infusions/?$" "/linee/linea.html?id=innovation" [R=301,L]
  RewriteRule "^brands/erboristica/skincare\-innovation/pearls/?$" "/linee/linea.html?id=innovation" [R=301,L]
  RewriteRule "^brands/erboristica/uomo/?$" "/linee/linea.html?id=uomo" [R=301,L]

  # --- Prodotti Sphea ---
  RewriteRule "^product/anti\-pollution\-face\-serum\-sphea/?$" "/prodotto-sphea.html?id=anti-pollution" [R=301,L]
  RewriteRule "^product/eyelift\-perfector\-sphea/?$" "/prodotto-sphea.html?id=eyelift-perfector" [R=301,L]
  RewriteRule "^product/radiant\-up\-lift\-face\-serum\-sphea/?$" "/prodotto-sphea.html?id=radiant-up-lift" [R=301,L]
  RewriteRule "^product/sculpt\-firm\-body\-serum\-sphea/?$" "/prodotto-sphea.html?id=sculpt-firm" [R=301,L]
  RewriteRule "^product/slim\-silhouette\-body\-serum\-sphea/?$" "/prodotto-sphea.html?id=slim-silhouette" [R=301,L]

  # --- Prodotti Kaley (schede solo redirect -> hub) ---
  RewriteRule "^product/crystal\-rouge\-kaley/?$" "/linee/kaley.html" [R=301,L]
  RewriteRule "^product/dark\-sea\-kaley/?$" "/linee/kaley.html" [R=301,L]
  RewriteRule "^product/golden\-hour\-kaley/?$" "/linee/kaley.html" [R=301,L]
  RewriteRule "^product/moka\-rose\-kaley/?$" "/linee/kaley.html" [R=301,L]
  RewriteRule "^product/monty\-tonka\-kaley/?$" "/linee/kaley.html" [R=301,L]
  RewriteRule "^product/spring\-symphony\-kaley/?$" "/linee/kaley.html" [R=301,L]
  RewriteRule "^product/sweet\-whisper\-kaley/?$" "/linee/kaley.html" [R=301,L]

  # --- Prodotti Everby ---
  RewriteRule "^product/cica\-cloud\-hydra\-mousse\-detergente\-viso\-delicata/?$" "/prodotto.html?id=everby-cica-cloud-hydra-mousse-detergente-viso-delicata" [R=301,L]
  RewriteRule "^product/dont\-call\-me\-panda\-contorno\-occhi\-per\-borse\-e\-occhiaie/?$" "/prodotto.html?id=everby-contorno-occhi-dont-call-me-panda" [R=301,L]
  RewriteRule "^product/feel\-butter\-gel\-burro\-struccante/?$" "/prodotto.html?id=everby-gel-burro-struccante-feel-butter" [R=301,L]
  RewriteRule "^product/lash\-me\-siero\-ciglia\-e\-sopracciglia\-allungante\-e\-rinforzante/?$" "/prodotto.html?id=everby-siero-ciglia-e-sopracciglia-lash-me" [R=301,L]
  RewriteRule "^product/milky\-rice\-hydrating\-milky\-toner/?$" "/prodotto.html?id=everby-milky-rice-hydrating-milky-toner" [R=301,L]
  RewriteRule "^product/no\-cry\-zone\-struccante\-bifasico\-occhi\-delicato/?$" "/prodotto.html?id=everby-no-cry-zone-truccante-bifasico-occhi-delicato" [R=301,L]
  RewriteRule "^product/pepti\-boom\-lip\-filler\-volumizzante/?$" "/prodotto.html?id=everby-pepti-boom-lip-filler-volumizzante-labbra" [R=301,L]
  RewriteRule "^product/pump\-plump\-siero\-viso\-rimpolpante/?$" "/prodotto.html?id=everby-siero-viso-rimpolpante-pump-e-plump" [R=301,L]
  RewriteRule "^product/stay\-porefect\-siero\-viso\-perfezionatore/?$" "/prodotto.html?id=everby-trattamento-viso-perfezionatore-pori-dilatati-stay-po" [R=301,L]
  RewriteRule "^product/yes\-i\-glow\-gocce\-viso\-illuminanti/?$" "/prodotto.html?id=everby-gocce-illuminanti-viso-yes-i-glow" [R=301,L]

  # --- Prodotti Antieta Globale ---
  RewriteRule "^product/antieta\-globale\-concentrato\-rimpolpante\-in\-fiale/?$" "/prodotto.html?id=antieta-fiale-concentrato-rimpolpante" [R=301,L]
  RewriteRule "^product/antieta\-globale\-contorno\-occhi/?$" "/prodotto.html?id=antieta-contorno-occhi" [R=301,L]
  RewriteRule "^product/antieta\-globale\-crema\-viso\-giorno/?$" "/prodotto.html?id=antieta-crema-viso-giorno" [R=301,L]
