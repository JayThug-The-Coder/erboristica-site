  RewriteRule "^product/uomo\-eau\-de\-toilette/?$" "/prodotto.html?id=uomo-eau-de-toilette-uomo" [R=301,L]
  RewriteRule "^product/uomo\-olio\-da\-barba/?$" "/prodotto.html?id=uomo-olio-da-barba-uomo" [R=301,L]
  RewriteRule "^product/uomo\-sapone\-vegetale/?$" "/prodotto.html?id=uomo-sapone-vegetale-uomo" [R=301,L]
  RewriteRule "^product/uomo\-shampoo\-doccia/?$" "/prodotto.html?id=uomo-shampoo-doccia-uomo" [R=301,L]
