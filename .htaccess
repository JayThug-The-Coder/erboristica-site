  RewriteRule "^product/cocco\-shampoo\-protettivo/?$" "/prodotto.html?id=cocco-shampoo-cocco" [R=301,L]
  RewriteRule "^product/cocco\-spray\-idrantante\-rinfrescante/?$" "/prodotto.html?id=cocco-spray-cocco-e-aloe-vera" [R=301,L]
  RewriteRule "^product/olio\-secco\-illuminante/?$" "/prodotto.html?id=cocco-olio-secco-illuminante" [R=301,L]

  # --- Prodotti Estratti Botanici ---
